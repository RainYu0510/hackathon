[gd_scene load_steps=4 format=3]

[ext_resource path="res://ui/PauseMenu.gd" type="Script" id="1"]
[ext_resource path="res://ui/menu_theme.tres" type="Theme" id="2"]

; 跟主選單同一套彈出視窗樣式:不透明底色 + 邊框。alpha 必須是 1,
; 不然遊戲畫面會透過來跟面板文字疊在一起。
[sub_resource type="StyleBoxFlat" id="PanelStyle"]
bg_color = Color(0.07, 0.09, 0.16, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.35, 0.62, 0.78, 1)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 28.0
content_margin_top = 24.0
content_margin_right = 28.0
content_margin_bottom = 24.0

; layer 100:要蓋過關卡的 HUD(預設 layer 1)與護目鏡閃光(layer 90)。
[node name="PauseMenu" type="CanvasLayer"]
layer = 100
script = ExtResource("1")
[node name="Root" type="Control" parent="."]
visible = false
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("2")
[node name="Dimmer" type="ColorRect" parent="Root"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.02, 0.03, 0.07, 0.82)
[node name="Panel" type="PanelContainer" parent="Root"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -190.0
offset_top = -160.0
offset_right = 190.0
offset_bottom = 160.0
theme_override_styles/panel = SubResource("PanelStyle")
[node name="Content" type="VBoxContainer" parent="Root/Panel"]
theme_override_constants/separation = 14
[node name="PauseTitle" type="Label" parent="Root/Panel/Content"]
text = "暫停"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 32
theme_override_colors/font_color = Color(0.874, 0.988, 1, 1)
[node name="ResumeButton" type="Button" parent="Root/Panel/Content"]
custom_minimum_size = Vector2(0, 48)
text = "繼續遊戲  RESUME"
[node name="MenuButton" type="Button" parent="Root/Panel/Content"]
custom_minimum_size = Vector2(0, 48)
text = "回主選單  MAIN MENU"
[node name="QuitButton" type="Button" parent="Root/Panel/Content"]
custom_minimum_size = Vector2(0, 48)
text = "離開遊戲  QUIT"
